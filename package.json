{
  "name": "@fysunlabs/aec-mcp",
  "version": "1.1.0",
  "description": "Open-source stdio MCP client for AEC (Agent Experience Center) kernels. Zero kernel dependency: all business ops go over a hardened HTTP transport.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "aec-mcp": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/mcp.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fysunlabs/aec-mcp.git"
  },
  "homepage": "https://github.com/fysunlabs/aec-mcp#readme",
  "bugs": {
    "url": "https://github.com/fysunlabs/aec-mcp/issues"
  },
  "files": [
    "src/",
    "config/mcp.example.json",
    "README.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "aec",
    "agent-experience-center",
    "stdio",
    "model-context-protocol"
  ]
}
